{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gakushu-sochi-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/login", "/logout"],
  },
  "vars": { "API_ORIGIN": "https://gakushu-sochi-api.<account>.workers.dev" },
  "secrets": { "required": ["API_TOKEN", "WEB_ACCESS_PASSPHRASE"] },
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "<create-before-deploy>" }],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
