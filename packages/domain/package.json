{
  "name": "@gakushu-sochi/domain",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "gen:concepts": "node scripts/gen-concepts.mjs",
    "check:concepts": "node scripts/gen-concepts.mjs --check",
    "test:unit": "vitest run src",
    "test:watch": "vitest src",
    "lint": "eslint src",
    "check:types": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
